// ============================================================================
//  BAZAAR - Database Schema
//  PostgreSQL 17 + Prisma 6   |   Blueprint Part C
//
//  Models are PascalCase; tables and columns are mapped to snake_case so raw
//  SQL, psql sessions and Meilisearch sync scripts all read naturally.
//
//  Two indexes from C1.6 cannot be expressed in the Prisma DSL - monthly
//  partitioning of page_views and the tsvector full-text index on products.
//  Both are captured as raw SQL in prisma/migrations/README.md.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum Currency {
  NPR
  USD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  ESEWA
  KHALTI
  CONNECTIPS
  FONEPAY
  IME_PAY
  STRIPE
  PAYPAL
  BANK_TRANSFER
  COD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum NotificationType {
  ORDER
  PROMO
  SYSTEM
  PRICE_DROP
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

enum AdminAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
}

// ============================================================================
//  C1.1  USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique @db.VarChar(255)
  /// Nepal-critical: phone is the OTP login identity.
  phone         String?       @unique @db.VarChar(20)
  passwordHash  String?       @map("password_hash") @db.VarChar(255)
  fullName      String        @map("full_name") @db.VarChar(120)
  avatarUrl     String?       @map("avatar_url") @db.Text
  role          UserRole      @default(CUSTOMER)
  emailVerified Boolean       @default(false) @map("email_verified")
  phoneVerified Boolean       @default(false) @map("phone_verified")
  status        AccountStatus @default(ACTIVE)
  /// Optional TOTP secret for admin 2FA (D4).
  twoFactorSecret String?     @map("two_factor_secret") @db.VarChar(255)
  lastLoginAt   DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses           Address[]
  sessions            Session[]
  oauthAccounts       OAuthAccount[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  reviews             Review[]
  wishlists           Wishlist[]
  cartItems           CartItem[]
  notifications       Notification[]
  couponUsages        CouponUsage[]
  adminActivityLogs   AdminActivityLog[]
  pageViews           PageView[]
  orderStatusChanges  OrderStatusHistory[] @relation("StatusChangedBy")
  repliedMessages     ContactMessage[]     @relation("RepliedByAdmin")
  updatedSettings     StoreSetting[]       @relation("SettingUpdatedBy")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model Address {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  label      String  @default("Home") @db.VarChar(40)
  fullName   String  @map("full_name") @db.VarChar(120)
  phone      String  @db.VarChar(20)
  street     String  @db.VarChar(200)
  city       String  @db.VarChar(80)
  /// One of the 77 districts - validated by @bazaar/shared before it reaches here.
  district   String  @db.VarChar(60)
  /// One of the 7 provinces.
  province   String  @db.VarChar(40)
  postalCode String? @map("postal_code") @db.VarChar(16)
  country    String  @default("Nepal") @db.VarChar(60)
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  isDefault  Boolean @default(false) @map("is_default")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([district, province])
  @@map("addresses")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// D1: only the hash is stored, never the raw refresh token.
  tokenHash  String   @unique @map("token_hash") @db.VarChar(255)
  deviceInfo String?  @map("device_info") @db.VarChar(255)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OAuthAccount {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  provider   OAuthProvider
  providerId String        @map("provider_id") @db.VarChar(255)
  email      String?       @db.VarChar(255)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================================
//  C1.2  PRODUCTS & CATALOG
// ============================================================================

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(80)
  slug            String   @unique @db.VarChar(120)
  description     String?  @db.Text
  imageUrl        String?  @map("image_url") @db.Text
  /// Self-relation gives Electronics > Phones > Smartphones.
  parentId        String?  @map("parent_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title") @db.VarChar(70)
  metaDescription String?  @map("meta_description") @db.VarChar(160)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  sku              String        @unique @db.VarChar(64)
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  /// Rich text (TipTap HTML), sanitised with DOMPurify before render (D1).
  description      String?       @db.Text
  shortDescription String?       @map("short_description") @db.VarChar(500)
  basePrice        Decimal       @map("base_price") @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  costPrice        Decimal?      @map("cost_price") @db.Decimal(12, 2)
  currency         Currency      @default(NPR)
  categoryId       String        @map("category_id") @db.Uuid
  brand            String?       @db.VarChar(80)
  /// Native Postgres array - GIN indexed for tag filtering.
  tags             String[]      @default([])
  /// JSONB: { "color": "Red", "size": "XL", "material": "Cotton" }
  attributes       Json          @default("{}") @db.JsonB
  status           ProductStatus @default(DRAFT)
  isActive         Boolean       @default(true) @map("is_active")
  isFeatured       Boolean       @default(false) @map("is_featured")
  isDigital        Boolean       @default(false) @map("is_digital")
  weight           Decimal?      @db.Decimal(10, 3)
  dimensions       Json?         @db.JsonB
  metaTitle        String?       @map("meta_title") @db.VarChar(70)
  metaDescription  String?       @map("meta_description") @db.VarChar(160)
  viewCount        Int           @default(0) @map("view_count")
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  images     ProductImage[]
  videos     ProductVideo[]
  reviews    Review[]
  wishlists  Wishlist[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  // --- C1.6 -----------------------------------------------------------------
  @@index([categoryId, isActive, createdAt])
  @@index([tags(ops: ArrayOps)], type: Gin)
  @@index([attributes(ops: JsonbOps)], type: Gin)
  @@index([isFeatured, isActive])
  @@index([brand])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique @db.VarChar(64)
  /// e.g. "Red / XL"
  name          String   @db.VarChar(120)
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  /// JSONB: the attribute combination this variant represents.
  attributes    Json     @default("{}") @db.JsonB
  imageIds      String[] @default([]) @map("image_ids") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String  @db.Text
  altText   String? @map("alt_text") @db.VarChar(200)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  width     Int?
  height    Int?
  /// Blurhash string powering instant blur-up placeholders (A1.1).
  blurhash  String? @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVideo {
  id              String  @id @default(uuid()) @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  url             String  @db.Text
  thumbnailUrl    String? @map("thumbnail_url") @db.Text
  durationSeconds Int?    @map("duration_seconds")
  sortOrder       Int     @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_videos")
}

model Inventory {
  id              String   @id @default(uuid()) @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  /// Multi-warehouse support; null means the default warehouse.
  warehouseId     String?  @map("warehouse_id") @db.VarChar(64)
  quantity        Int      @default(0)
  /// Held during checkout, released on cancel or timeout (D2).
  reservedQuantity Int     @default(0) @map("reserved_quantity")
  reorderLevel    Int      @default(0) @map("reorder_level")
  reorderQuantity Int      @default(0) @map("reorder_quantity")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([quantity])
  @@map("inventory")
}

// ============================================================================
//  C1.3  ORDERS & PAYMENTS
// ============================================================================

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  /// Readable and unique: ORD-20270815-XXXX
  orderNumber     String      @unique @map("order_number") @db.VarChar(32)
  /// Null once a customer deletes their account - orders survive for accounting.
  userId          String?     @map("user_id") @db.Uuid
  /// Guest checkout is supported; email is required for order tracking (G1).
  guestEmail      String?     @map("guest_email") @db.VarChar(255)
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingCost    Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  currency        Currency    @default(NPR)
  /// JSONB snapshots - the user may edit their address book afterwards.
  shippingAddress Json        @map("shipping_address") @db.JsonB
  billingAddress  Json?       @map("billing_address") @db.JsonB
  notes           String?     @db.VarChar(1000)
  cancelledReason String?     @map("cancelled_reason") @db.VarChar(500)
  trackingNumber  String?     @map("tracking_number") @db.VarChar(120)
  carrier         String?     @db.VarChar(80)
  placedAt        DateTime?   @map("placed_at") @db.Timestamptz(6)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  couponUsages  CouponUsage[]

  // --- C1.6 -----------------------------------------------------------------
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([guestEmail])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  /// Denormalised so the line survives product or variant deletion.
  productName String  @map("product_name") @db.VarChar(200)
  variantName String? @map("variant_name") @db.VarChar(120)
  sku         String  @db.VarChar(64)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)
  /// D2: immutable snapshot of the product at purchase time.
  productSnapshot Json @map("product_snapshot") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        Currency      @default(NPR)
  /// Gateway reference only - PCI DSS: card numbers are never stored (D1).
  transactionId   String?       @map("transaction_id") @db.VarChar(200)
  /// Raw gateway payload, kept for reconciliation and disputes.
  gatewayResponse Json?         @map("gateway_response") @db.JsonB
  /// D2: prevents duplicate webhook processing.
  idempotencyKey  String?       @unique @map("idempotency_key") @db.VarChar(120)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt(sort: Desc)])
  @@index([transactionId])
  @@map("payments")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  amount          Decimal      @db.Decimal(12, 2)
  reason          String       @db.VarChar(500)
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?      @map("gateway_refund_id") @db.VarChar(200)
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  /// Null for automated transitions (payment webhooks, cron jobs).
  changedBy String?     @map("changed_by") @db.Uuid
  note      String?     @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin User? @relation("StatusChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ============================================================================
//  C1.4  REVIEWS, COUPONS, WISHLIST, CART
// ============================================================================

model Review {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  rating             Int      @db.SmallInt
  title              String?  @db.VarChar(120)
  body               String   @db.Text
  images             String[] @default([])
  /// D2: only users who actually bought the product can review it.
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  isApproved         Boolean  @default(false) @map("is_approved")
  helpfulCount       Int      @default(0) @map("helpful_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// D2: one review per product per user.
  @@unique([productId, userId])
  // --- C1.6 -----------------------------------------------------------------
  @@index([productId, isApproved, createdAt(sort: Desc)])
  @@index([rating])
  @@map("reviews")
}

model Coupon {
  id                   String     @id @default(uuid()) @db.Uuid
  code                 String     @unique @db.VarChar(40)
  type                 CouponType
  value                Decimal    @db.Decimal(12, 2)
  minOrderAmount       Decimal?   @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount    Decimal?   @map("max_discount_amount") @db.Decimal(12, 2)
  usageLimit           Int?       @map("usage_limit")
  usedCount            Int        @default(0) @map("used_count")
  perUserLimit         Int?       @map("per_user_limit")
  validFrom            DateTime   @map("valid_from") @db.Timestamptz(6)
  validUntil           DateTime   @map("valid_until") @db.Timestamptz(6)
  applicableCategories String[]   @default([]) @map("applicable_categories") @db.Uuid
  applicableProducts   String[]   @default([]) @map("applicable_products") @db.Uuid
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  usages CouponUsage[]

  @@index([isActive, validFrom, validUntil])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid()) @db.Uuid
  couponId String   @map("coupon_id") @db.Uuid
  userId   String?  @map("user_id") @db.Uuid
  orderId  String?  @map("order_id") @db.Uuid
  usedAt   DateTime @default(now()) @map("used_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
  @@map("coupon_usage")
}

model Wishlist {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  /// Baseline for price-drop alerts (G2).
  priceAtAdd Decimal  @map("price_at_add") @db.Decimal(12, 2)
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId, addedAt(sort: Desc)])
  @@map("wishlists")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  /// Null for guests, who are tracked by sessionId until their cart is merged.
  userId    String?  @map("user_id") @db.Uuid
  sessionId String?  @map("session_id") @db.VarChar(120)
  productId String   @map("product_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // --- C1.6: prevents duplicate cart lines ---------------------------------
  @@unique([userId, variantId])
  @@unique([sessionId, variantId])
  @@index([sessionId])
  @@map("cart_items")
}

// ============================================================================
//  C1.5  ADMIN & ANALYTICS
// ============================================================================

model AdminActivityLog {
  id         String      @id @default(uuid()) @db.Uuid
  adminId    String?     @map("admin_id") @db.Uuid
  action     AdminAction
  entityType String      @map("entity_type") @db.VarChar(60)
  entityId   String?     @map("entity_id") @db.VarChar(64)
  /// D2: the diff of what changed, plus request context.
  details    Json?       @db.JsonB
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.VarChar(500)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("admin_activity_log")
}

/// C1.6 notes this table should be partitioned by month once volume justifies it -
/// see prisma/migrations/README.md for the raw SQL.
model PageView {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.VarChar(120)
  userId     String?  @map("user_id") @db.Uuid
  pagePath   String   @map("page_path") @db.VarChar(500)
  referrer   String?  @db.VarChar(500)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  country    String?  @db.VarChar(60)
  city       String?  @db.VarChar(80)
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([sessionId])
  @@index([pagePath, createdAt])
  @@map("page_views")
}

/// Materialised daily aggregate so the admin dashboard never scans orders.
model RevenueDaily {
  date               DateTime @id @db.Date
  totalRevenue       Decimal  @default(0) @map("total_revenue") @db.Decimal(14, 2)
  orderCount         Int      @default(0) @map("order_count")
  avgOrderValue      Decimal  @default(0) @map("avg_order_value") @db.Decimal(12, 2)
  newCustomers       Int      @default(0) @map("new_customers")
  returningCustomers Int      @default(0) @map("returning_customers")
  refundAmount       Decimal  @default(0) @map("refund_amount") @db.Decimal(12, 2)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("revenue_daily")
}

/// Key/value store config: store name, logo, currency, tax rates, shipping zones.
model StoreSetting {
  key       String   @id @db.VarChar(80)
  value     Json     @db.JsonB
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  admin User? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("store_settings")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(1000)
  data      Json?            @db.JsonB
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model ContactMessage {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(120)
  email     String        @db.VarChar(255)
  phone     String?       @db.VarChar(20)
  subject   String        @db.VarChar(200)
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  repliedAt DateTime?     @map("replied_at") @db.Timestamptz(6)
  repliedBy String?       @map("replied_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User? @relation("RepliedByAdmin", fields: [repliedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_messages")
}

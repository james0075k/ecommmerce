# ---------------------------------------------------------------------------
# BAZAAR - Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL 17) ----------------------------------------------
POSTGRES_USER=bazaar
POSTGRES_PASSWORD=bazaar_dev_password
POSTGRES_DB=bazaar
DATABASE_URL="postgresql://bazaar:bazaar_dev_password@localhost:5432/bazaar?schema=public"

# --- Cache / Sessions / Queues (Redis 8) -----------------------------------
REDIS_URL="redis://localhost:6379"

# --- Search (Meilisearch) --------------------------------------------------
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="bazaar_dev_master_key_change_me_min_16_chars"

# --- API server ------------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN="http://localhost:3000"
# Where gateways send shoppers back to. Must be reachable by eSewa/Khalti/etc,
# so in development this needs a tunnel (ngrok, cloudflared) rather than
# localhost - a bank's server cannot resolve your laptop.
API_PUBLIC_URL="http://localhost:4000/api/v1"

# --- Auth (JWT) ------------------------------------------------------------
JWT_SECRET="change_me_in_production_min_32_characters_long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_too_in_production_min_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Auth (NextAuth v5, frontend) ------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_with_openssl_rand_base64_32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Storage (AWS S3 + CloudFront) -----------------------------------------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="bazaar-media"
CDN_URL=""

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Bazaar <noreply@bazaar.com.np>"

# --- SMS (Nepal - Sparrow SMS) ---------------------------------------------
SPARROW_SMS_TOKEN=""
SPARROW_SMS_FROM="Bazaar"

# --- Payments: Nepal -------------------------------------------------------
# eSewa RC sandbox. EPAYTEST/8gBm... are eSewa's own public test credentials.
# Test logins 9806800001-05, password/MPIN Nepal@123, token 123456.
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_BASE_URL="https://rc-epay.esewa.com.np"

# Khalti sandbox. Test wallets 9800000000-05, MPIN 1111, OTP 987654.
KHALTI_SECRET_KEY=""
KHALTI_BASE_URL="https://a.khalti.com"

# ConnectIPS (NCHL). The private key is the PKCS#12 key NCHL issues, either as
# a PEM (newlines escaped as \n) or base64-encoded.
CONNECTIPS_MERCHANT_ID=""
CONNECTIPS_APP_ID=""
CONNECTIPS_APP_NAME=""
CONNECTIPS_APP_PASSWORD=""
CONNECTIPS_PRIVATE_KEY=""
CONNECTIPS_KEY_PASSPHRASE=""
CONNECTIPS_BASE_URL="https://uat.connectips.com"

# Fonepay dynamic QR.
FONEPAY_MERCHANT_CODE=""
FONEPAY_SECRET_KEY=""
FONEPAY_USERNAME=""
FONEPAY_PASSWORD=""
FONEPAY_BASE_URL="https://dev-merchantapi.fonepay.com"

# IME Pay.
IMEPAY_MERCHANT_CODE=""
IMEPAY_USERNAME=""
IMEPAY_PASSWORD=""
IMEPAY_MODULE=""
IMEPAY_BASE_URL="https://stg.imepay.com.np:7979"

# --- Payments: Global ------------------------------------------------------
# Stripe test mode. Card 4242 4242 4242 4242, any future expiry, any CVC.
# Get the webhook secret from `stripe listen --forward-to
# localhost:4000/api/v1/payments/stripe/webhook`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
# PayPal cannot settle NPR, so rupee orders are presented in USD at this rate.
NPR_TO_USD_RATE="0.0075"

# --- Payments: manual ------------------------------------------------------
BANK_TRANSFER_BANK=""
BANK_TRANSFER_ACCOUNT=""
BANK_TRANSFER_NAME=""

# --- Store details (printed on the invoice) --------------------------------
STORE_PAN=""
STORE_ADDRESS="Kathmandu, Bagmati\nNepal\nsupport@bazaar.com"

# --- AI (Claude) -----------------------------------------------------------
ANTHROPIC_API_KEY=""
# Any model id from the Claude API. Leave as-is unless you have a reason.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Observability ---------------------------------------------------------
SENTRY_DSN=""

# --- Frontend public vars (must be prefixed NEXT_PUBLIC_) ------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_MEILI_HOST="http://localhost:7700"
NEXT_PUBLIC_MEILI_SEARCH_KEY=""

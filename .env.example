# ---------------------------------------------------------------------------
# BAZAAR - Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL 17) ----------------------------------------------
POSTGRES_USER=bazaar
POSTGRES_PASSWORD=bazaar_dev_password
POSTGRES_DB=bazaar
DATABASE_URL="postgresql://bazaar:bazaar_dev_password@localhost:5432/bazaar?schema=public"

# --- Cache / Sessions / Queues (Redis 8) -----------------------------------
REDIS_URL="redis://localhost:6379"

# --- Search (Meilisearch) --------------------------------------------------
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="bazaar_dev_master_key_change_me_min_16_chars"

# --- API server ------------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN="http://localhost:3000"

# --- Auth (JWT) ------------------------------------------------------------
JWT_SECRET="change_me_in_production_min_32_characters_long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_too_in_production_min_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Auth (NextAuth v5, frontend) ------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_with_openssl_rand_base64_32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Storage (AWS S3 + CloudFront) -----------------------------------------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="bazaar-media"
CDN_URL=""

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Bazaar <noreply@bazaar.com.np>"

# --- SMS (Nepal - Sparrow SMS) ---------------------------------------------
SPARROW_SMS_TOKEN=""
SPARROW_SMS_FROM="Bazaar"

# --- Payments: Nepal -------------------------------------------------------
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_BASE_URL="https://rc-epay.esewa.com.np"
KHALTI_SECRET_KEY=""
KHALTI_BASE_URL="https://a.khalti.com"
CONNECTIPS_MERCHANT_ID=""
FONEPAY_MERCHANT_CODE=""
IMEPAY_MERCHANT_CODE=""

# --- Payments: Global ------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# --- AI (Claude) -----------------------------------------------------------
ANTHROPIC_API_KEY=""

# --- Observability ---------------------------------------------------------
SENTRY_DSN=""

# --- Frontend public vars (must be prefixed NEXT_PUBLIC_) ------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_MEILI_HOST="http://localhost:7700"
NEXT_PUBLIC_MEILI_SEARCH_KEY=""

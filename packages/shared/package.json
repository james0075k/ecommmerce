    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bazaar/config": "workspace:*",

# apps/api reads the workspace-root .env by default (see src/config/env.ts).
# Override any of these per-developer by creating apps/api/.env.
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN="http://localhost:3000"
DATABASE_URL="postgresql://bazaar:bazaar_dev_password@localhost:5432/bazaar?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change_me_in_production_min_32_characters_long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_too_in_production_min_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"
